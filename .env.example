# Local development defaults; Render supplies DATABASE_URL and SECRET_KEY.
DATABASE_URL=sqlite:///foodconnect.db
UPLOAD_FOLDER=static/images/uploads
COOKIE_SECURE=0

# Optional Gmail SMTP for OTP. If blank, OTP is printed in the terminal.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Replace with a long random value for local development.
SECRET_KEY=replace-with-a-long-random-secret

# Email address of the verified account allowed to access admin reports.
ADMIN_EMAIL=
